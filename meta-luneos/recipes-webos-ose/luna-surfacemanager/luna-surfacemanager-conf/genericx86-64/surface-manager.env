QT_IM_MODULE=Maliit

# Force DRM EGL platform for real hardware (not Wayland or X11)
# Required: Mesa default native platform is Wayland; on bare metal there is no
# Wayland compositor running, so EGL init fails unless we override this.
EGL_PLATFORM=drm

# No VirtualBox/QEMU mouse plugin on real hardware
QT_QPA_EGLFS_HIDECURSOR=1

WEBOS_COMPOSITOR_EXTRA_OPTIONS="-plugin libinput"
